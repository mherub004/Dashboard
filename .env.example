DASHBOARD_URL=https://dashboard.iamahsan.org
AGENT_TOKEN=copy-from-the-dashboard-connect-server-screen
DOCKER_GID=999
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_HOST=unix:///var/run/docker.sock
AGENT_UID=10001
AGENT_GID=10001
# Rootless Docker: set both socket values to your user socket and set AGENT_UID/AGENT_GID to id -u/id -g.
# DOCKER_SOCKET=/run/user/1000/docker.sock
# DOCKER_HOST=unix:///run/user/1000/docker.sock
SERVER_NAME=My server
REPORT_INTERVAL=30
# Optional: choose the host network interface(s) you want to measure, e.g. eth0.
# Leaving this blank excludes loopback and common Docker bridge/veth interfaces.
NETWORK_INTERFACES=

# Optional WireGuard peer snapshot generated by scripts/wireguard_status.py on the host.
WIREGUARD_STATUS_FILE=/var/lib/mtech-infra/wireguard-status.json
# Optional path on the host, updated by your backup job only after a successful backup.
BACKUP_HEARTBEAT_FILE=/var/backups/last-successful-backup
